[
  {
    "id": "rishikesh-three-day-approved-plan",
    "scenario": "Domestic places-first plan with an explicit rafting exclusion",
    "invariants": {
      "destinations": ["Rishikesh"],
      "duration_days": 3,
      "preserve_approved_places": true,
      "exclude": ["river rafting"],
      "requires_day_timeline": true,
      "requires_budget_lines": true
    }
  },
  {
    "id": "delhi-agra-jaipur-fixed-route",
    "scenario": "Traveler explicitly fixes a seven-day circuit and route order",
    "invariants": {
      "destinations": ["Delhi", "Agra", "Jaipur"],
      "duration_days": 7,
      "preserve_destination_order": true,
      "do_not_add_destinations": true
    }
  },
  {
    "id": "international-current-rules",
    "scenario": "International plan where permits, border rules and operators are time-sensitive",
    "invariants": {
      "no_live_search_available": true,
      "do_not_claim_verified": true,
      "use_general_or_unresolved": true,
      "no_booking_claim": true
    }
  },
  {
    "id": "specific-hotel-not-found",
    "scenario": "A named stay cannot be confidently resolved",
    "invariants": {
      "do_not_invent_url": true,
      "allow_general_guidance": true,
      "record_unresolved": true,
      "no_deep_link": true
    }
  },
  {
    "id": "budget-total-consistency",
    "scenario": "Returned model totals conflict with category ranges",
    "invariants": {
      "backend_recalculates_totals": true,
      "non_negative_ranges": true,
      "single_currency": true
    }
  }
]
