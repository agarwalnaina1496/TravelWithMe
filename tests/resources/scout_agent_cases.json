[
  {
    "id": "advisor-answers-general-question",
    "scenario": "Traveler asks a general advisory question with no destination decided yet",
    "input": {
      "trip_state": {
        "stage": "new",
        "trip_context": {},
        "advisor_state": {
          "conversation_context": { "last_advisor_message": null }
        }
      },
      "message": "What's a good time of year to visit Kerala backwaters?"
    },
    "invariants": {
      "intent": "advise",
      "extracts_trip_context": true,
      "no_stage_transition": true,
      "must_not_set_selected_option": true
    }
  },
  {
    "id": "criteria-ready-routes-to-matcher",
    "scenario": "Traveler has given enough criteria (origin, budget, dates) to search for a destination",
    "input": {
      "trip_state": {
        "stage": "new",
        "trip_context": { "origin_city": "Delhi" },
        "advisor_state": {
          "conversation_context": { "last_advisor_message": null }
        }
      },
      "message": "I have INR 40000, want to travel from Delhi for 5 days in December."
    },
    "invariants": {
      "intent": "matcher",
      "must_clear_selected_option": true,
      "routes_to_meridian": true
    }
  },
  {
    "id": "destination-confirmed-routes-to-planner",
    "scenario": "Traveler already knows the destination and asks to start day-by-day planning",
    "input": {
      "trip_state": {
        "stage": "matched",
        "trip_context": {
          "origin_city": "Delhi",
          "destinations": ["Goa"],
          "trip_duration": 4
        },
        "advisor_state": {
          "conversation_context": { "last_advisor_message": null }
        }
      },
      "message": "Let's start planning day by day for Goa."
    },
    "invariants": {
      "intent": "planner",
      "routes_to_guide": true,
      "preserves_trip_context": true
    }
  },
  {
    "id": "extraction-preserves-advisor-message",
    "scenario": "Traveler shares new preferences mid-conversation before a routing decision is made",
    "input": {
      "trip_state": {
        "stage": "new",
        "trip_context": { "origin_city": "Delhi" },
        "advisor_state": {
          "conversation_context": {
            "last_advisor_message": "Do you prefer beaches or mountains?"
          }
        }
      },
      "message": "Actually I prefer mountains over beaches."
    },
    "invariants": {
      "intent": "advise",
      "must_not_set_selected_option": true,
      "advisor_message_stored_in_conversation_context": true
    }
  },
  {
    "id": "extracts-fixed-shared-keys-verbatim",
    "scenario": "Traveler gives origin, party size, duration, tentative dates, and a flexible budget in one message",
    "input": {
      "trip_state": {
        "stage": "new",
        "trip_context": {},
        "advisor_state": {
          "conversation_context": { "last_advisor_message": null }
        }
      },
      "message": "It's me and my partner, from Delhi, for about five days, sometime in October, budget is flexible."
    },
    "invariants": {
      "fixed_keys_present_verbatim": {
        "origin_city": "Delhi",
        "num_travelers": "me and my partner",
        "trip_duration": 5,
        "travel_dates": "sometime in October",
        "budget": "flexible"
      },
      "must_not_invent_synonym_keys": ["origin", "travelers", "party_size", "dates"]
    }
  }
]
